# fs0ciety Dashboard Configuration
# Copy this file to .env and fill in your values

# ─── General ───────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ─── Weather (Open-Meteo - no API key needed) ─────
WEATHER_LATITUDE=48.8566
WEATHER_LONGITUDE=2.3522
WEATHER_CITY=Paris

# ─── Docker ────────────────────────────────────────
# Docker socket is mounted via docker-compose volumes
# Only set this if using a TCP socket instead:
# DOCKER_HOST=unix:///var/run/docker.sock

# ─── Jellyfin ─────────────────────────────────────
# Dashboard → Administration → API Keys → +
JELLYFIN_URL=https://jellyfin.fs0ciety.org
JELLYFIN_API_KEY=

# ─── Sonarr ───────────────────────────────────────
# Settings → General → API Key
SONARR_URL=https://sonarr.internal.fs0ciety.org
SONARR_API_KEY=

# ─── Radarr ───────────────────────────────────────
# Settings → General → API Key
RADARR_URL=https://radarr.internal.fs0ciety.org
RADARR_API_KEY=

# ─── Lidarr ───────────────────────────────────────
# Settings → General → API Key
LIDARR_URL=https://lidarr.internal.fs0ciety.org
LIDARR_API_KEY=

# ─── SABnzbd ──────────────────────────────────────
# Config → General → API Key
SABNZBD_URL=https://nzb.internal.fs0ciety.org
SABNZBD_API_KEY=

# ─── qBittorrent ──────────────────────────────────
QBITTORRENT_URL=https://qbittorrent.internal.fs0ciety.org
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# ─── Jellyseerr ───────────────────────────────────
# Settings → General → API Key
JELLYSEERR_URL=https://requests.fs0ciety.org
JELLYSEERR_API_KEY=

# ─── Immich ───────────────────────────────────────
# Administration → API Keys
IMMICH_URL=https://photos.internal.fs0ciety.org
IMMICH_API_KEY=

# ─── Jellystat ────────────────────────────────────
# Settings → API Key
JELLYSTAT_URL=https://stats.internal.fs0ciety.org
JELLYSTAT_API_KEY=

# ─── Forgejo ──────────────────────────────────────
# Settings → Applications → Generate Token
FORGEJO_URL=https://git.internal.fs0ciety.org
FORGEJO_TOKEN=
