# fs0ciety Dashboard Configuration
# Copy this file to .env and fill in your values
#
# IMPORTANT: Use Docker internal URLs (http://container-name:port)
# NOT the Traefik/public URLs (https://xxx.internal.fs0ciety.org)
# because Authentik blocks API calls that don't have a browser session.
#
# To find container names: docker ps --format '{{.Names}}'
# To find internal ports: docker inspect <container> | grep -i exposed

# ─── General ───────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ─── Weather (Open-Meteo - no API key needed) ─────
WEATHER_LATITUDE=48.8566
WEATHER_LONGITUDE=2.3522
WEATHER_CITY=Paris

# ─── Docker ────────────────────────────────────────
# Docker socket is mounted via docker-compose volumes

# ─── Jellyfin ─────────────────────────────────────
# Dashboard → Administration → API Keys → +
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# ─── Sonarr ───────────────────────────────────────
# Settings → General → API Key
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# ─── Radarr ───────────────────────────────────────
# Settings → General → API Key
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# ─── Lidarr ───────────────────────────────────────
# Settings → General → API Key
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=

# ─── SABnzbd ──────────────────────────────────────
# Config → General → API Key
SABNZBD_URL=http://sabnzbd:8080
SABNZBD_API_KEY=

# ─── qBittorrent ──────────────────────────────────
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# ─── Jellyseerr ───────────────────────────────────
# Settings → General → API Key
JELLYSEERR_URL=http://jellyseerr:5055
JELLYSEERR_API_KEY=

# ─── Immich ───────────────────────────────────────
# Administration → API Keys
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=

# ─── Jellystat ────────────────────────────────────
# Settings → API Key
JELLYSTAT_URL=http://jellystat:3000
JELLYSTAT_API_KEY=

# ─── Forgejo ──────────────────────────────────────
# Settings → Applications → Generate Token (scopes: read:user, read:repository)
FORGEJO_URL=http://forgejo:3000
FORGEJO_TOKEN=

# ─── Beszel (System Monitoring) ──────────────────
# Uses PocketBase auth - email/password of your Beszel user
BESZEL_URL=http://beszel:8090
BESZEL_EMAIL=
BESZEL_PASSWORD=

# ─── Google Calendar (optional) ──────────────────
# Use a public iCal URL from Google Calendar:
# Calendar Settings → Integrate calendar → Public URL to this calendar
GOOGLE_CALENDAR_URL=
