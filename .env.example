# fs0ciety Dashboard Configuration
# Copy this file to .env and adjust values as needed

# General
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Weather (Open-Meteo - no API key required)
# Set your coordinates for weather
WEATHER_LATITUDE=48.8566
WEATHER_LONGITUDE=2.3522
WEATHER_CITY=Paris

# Service API Keys (optional - for deeper integration)
# JELLYFIN_URL=https://jellyfin.fs0ciety.org
# JELLYFIN_API_KEY=your_jellyfin_api_key

# SONARR_URL=https://sonarr.internal.fs0ciety.org
# SONARR_API_KEY=your_sonarr_api_key

# RADARR_URL=https://radarr.internal.fs0ciety.org
# RADARR_API_KEY=your_radarr_api_key

# SABNZBD_URL=https://nzb.internal.fs0ciety.org
# SABNZBD_API_KEY=your_sabnzbd_api_key

# QBITTORRENT_URL=https://qbittorrent.internal.fs0ciety.org
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=your_password

# JELLYSEERR_URL=https://requests.fs0ciety.org
# JELLYSEERR_API_KEY=your_jellyseerr_api_key

# UPTIME_KUMA_URL=https://status.fs0ciety.org
